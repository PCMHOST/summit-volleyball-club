---
import { clubInfo } from '../data/clubData';
---

<!-- High-Energy Social Strip (Carolina Blue with Black Contrast) -->
<div class="bg-brand-blue py-5 text-athletic-black">
  <div class="max-w-7xl mx-auto px-5 md:px-12 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
    <div class="flex items-center gap-3">
      <span class="material-symbols-outlined text-3xl text-athletic-black">photo_camera</span>
      <div>
        <div class="font-display text-2xl sm:text-[1.75rem] uppercase font-black tracking-wider leading-none text-athletic-black">
          FOLLOW @SUMMITVOLLEYBALLCLUB ON INSTAGRAM &amp; FACEBOOK
        </div>
        <div class="text-xs text-slate-800 font-medium mt-1">
          Live match highlights, tournament updates, and behind-the-scenes club life.
        </div>
      </div>
    </div>
    <a
      class="bg-athletic-black text-white hover:bg-athletic-charcoal px-5 py-2.5 rounded-sm font-display text-lg uppercase font-extrabold tracking-wider transition-colors shrink-0 shadow"
      href={clubInfo.socials.instagram}
      rel="noopener noreferrer"
      target="_blank"
    >
      FOLLOW OUR JOURNEY ➔
    </a>
  </div>
</div>

<!-- Sleek Black / Dark Charcoal Footer -->
<footer class="bg-athletic-black text-white border-t border-white/10">
  <div class="max-w-7xl mx-auto px-5 md:px-12 py-14 grid grid-cols-1 md:grid-cols-4 gap-6">
    <!-- Col 1: Brand & Logo -->
    <div class="space-y-4">
      <a href="/" class="flex items-center gap-3">
        <img
          alt="Summit Volleyball Club Kansas City Logo"
          class="h-14 w-14 rounded-md object-contain border border-brand-blue/40 shadow-sm bg-white p-0.5"
          src="/images/logo.png"
        />
        <div>
          <div class="font-display text-[1.75rem] font-black tracking-wider text-white uppercase leading-none">
            SVC
          </div>
          <div class="text-xs uppercase font-bold tracking-widest text-brand-blue">
            Summit Volleyball Club
          </div>
        </div>
      </a>
      <p class="text-sm text-slate-400 leading-relaxed">
        Summit Volleyball Club is Lee's Summit and Kansas City's premier destination for youth volleyball training, national travel teams, and athlete development.
      </p>
      <div class="flex items-center gap-2 pt-2">
        <span class="px-2 py-1 bg-athletic-charcoal text-[11px] font-bold rounded uppercase border border-white/10 text-brand-blue">
          USAV HOA MEMBER
        </span>
        <span class="px-2 py-1 bg-athletic-charcoal text-[11px] font-bold rounded uppercase border border-white/10 text-brand-blue">
          JVA AFFILIATE
        </span>
      </div>
    </div>

    <!-- Col 2: Quick Links -->
    <div class="space-y-3">
      <h3 class="font-display text-xl uppercase tracking-wide text-brand-blue font-bold border-b border-white/10 pb-1.5">
        QUICK NAVIGATION
      </h3>
      <ul class="space-y-2 text-xs font-semibold text-slate-300">
        <li><a class="hover:text-brand-blue transition-colors" href="/">Home Page</a></li>
        <li><a class="hover:text-brand-blue transition-colors" href="/about">About Summit VC</a></li>
        <li><a class="hover:text-brand-blue transition-colors" href="/teams">Club Teams (Girls &amp; Boys)</a></li>
        <li><a class="hover:text-brand-blue transition-colors" href="/tryouts">Tryout Schedule &amp; Age Groups</a></li>
        <li><a class="hover:text-brand-blue transition-colors" href="/camps-clinics">Camps, Clinics &amp; Open Gyms</a></li>
        <li><a class="hover:text-brand-blue transition-colors" href="/qualifications">National Qualifications</a></li>
      </ul>
    </div>

    <!-- Col 3: Information & Resources -->
    <div class="space-y-3">
      <h3 class="font-display text-xl uppercase tracking-wide text-brand-blue font-bold border-b border-white/10 pb-1.5">
        INFORMATION &amp; RESOURCES
      </h3>
      <ul class="space-y-2 text-xs font-semibold text-slate-300">
        <li><a class="hover:text-brand-blue transition-colors" href="/coaches">2026–2027 Coaching Staff</a></li>
        <li><a class="hover:text-brand-blue transition-colors" href="/sponsorships">Sponsorships &amp; Partners</a></li>
        <li><a class="hover:text-brand-blue transition-colors" href="/for-parents">For Parents &amp; Families</a></li>
        <li><a class="hover:text-brand-blue transition-colors" href="/for-coaches">For Coaches &amp; Managers</a></li>
        <li><a class="hover:text-brand-blue transition-colors" href="/swag-store">SVC Swag Store</a></li>
        <li><a class="hover:text-brand-blue transition-colors" href="/facility">Our Facility (TM Fieldhouse)</a></li>
        <li><a class="hover:text-brand-blue transition-colors" href="/contact">Contact Us</a></li>
      </ul>
    </div>

    <!-- Col 4: Location & Contact -->
    <div class="space-y-3">
      <h3 class="font-display text-xl uppercase tracking-wide text-brand-blue font-bold border-b border-white/10 pb-1.5">
        LOCATION &amp; CONTACT
      </h3>
      <div class="space-y-2 text-xs text-slate-300">
        <p class="flex items-start gap-2">
          <span class="material-symbols-outlined text-sm text-brand-blue mt-0.5">home</span>
          <span>
            <strong>{clubInfo.facility.name}</strong><br />
            {clubInfo.facility.address}<br />
            {clubInfo.facility.city}
          </span>
        </p>
        <p class="flex items-center gap-2">
          <span class="material-symbols-outlined text-sm text-brand-blue">phone</span>
          <a class="hover:underline hover:text-brand-blue transition-colors" href="tel:8166008383">{clubInfo.phone}</a>
        </p>
        <p class="flex items-center gap-2">
          <span class="material-symbols-outlined text-sm text-brand-blue">email</span>
          <a class="hover:underline hover:text-brand-blue transition-colors" href={`mailto:${clubInfo.email}`}>{clubInfo.email}</a>
        </p>
        <p class="flex items-center gap-2 text-[11px] text-slate-400 pt-1">
          <span class="material-symbols-outlined text-sm text-brand-blue">schedule</span>
          <span>Mon–Sun: 4:00 PM – 10:00 PM</span>
        </p>
      </div>
    </div>
  </div>

  <!-- Legal Bottom Bar -->
  <div class="border-t border-white/10 py-5 bg-black text-xs text-slate-400">
    <div class="max-w-7xl mx-auto px-5 md:px-12 flex flex-col md:flex-row items-center justify-between gap-3 text-center md:text-left">
      <p>© {new Date().getFullYear()} Summit Volleyball Club. All Rights Reserved. Member of Heart of America Volleyball (HOA) &amp; USAV.</p>
      <div class="flex items-center gap-4 text-xs">
        <a class="hover:text-white underline" href="/about">Privacy Policy</a>
        <span>•</span>
        <a class="hover:text-white underline" href="/about">Terms of Service</a>
        <span>•</span>
        <a class="hover:text-white underline" href="/about">Code of Conduct</a>
      </div>
    </div>
  </div>
</footer>
