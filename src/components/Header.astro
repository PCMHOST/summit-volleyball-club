---
import { clubInfo, girlsTeams, boysTeams } from '../data/clubData';

const currentPath = Astro.url.pathname;

const infoLinks = [
  { label: 'About Us', href: '/about', icon: 'info', desc: 'Our mission, leadership & whole-athlete care' },
  { label: 'Qualifications', href: '/qualifications', icon: 'emoji_events', desc: 'USAV National Bids & regional titles' },
  { label: 'Coaching Staff', href: '/coaches', icon: 'groups', desc: 'Meet our 20+ USAV & JVA coaches' },
  { label: 'Sponsorships', href: '/sponsorships', icon: 'handshake', desc: 'Partner with Summit Volleyball Club' },
  { label: 'For Parents', href: '/for-parents', icon: 'family_restroom', desc: 'SportsEngine guide, resources & FAQs' },
  { label: 'For Coaches', href: '/for-coaches', icon: 'sports', desc: 'Team management & coaching resources' },
  { label: 'Swag Store', href: '/swag-store', icon: 'checkroom', desc: 'Official SVC apparel & fan gear' },
  { label: 'Our Facility', href: '/facility', icon: 'stadium', desc: 'TM Fieldhouse in Lee\'s Summit, MO' },
  { label: 'Contact Us', href: '/contact', icon: 'mail', desc: 'Get in touch with Club Directors' },
];

const isInfoActive = infoLinks.some((item) => currentPath.startsWith(item.href));
const isTeamsActive = currentPath.startsWith('/teams');
---

<!-- Utility Top Bar (Clean Black Athletic Bar with Powder Blue Accents) -->
<div class="bg-athletic-black text-white py-1.5 px-5 md:px-12 border-b border-white/10 text-xs">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-2">
    <!-- Left Contact Details -->
    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-slate-300 font-medium">
      <a href="/facility" class="flex items-center gap-1.5 hover:text-brand-blue transition-colors">
        <span class="material-symbols-outlined text-sm text-brand-blue">location_on</span>
        <span>TM Fieldhouse • Lee's Summit, MO</span>
      </a>
      <span class="hidden sm:inline text-slate-600">•</span>
      <a class="flex items-center gap-1.5 hover:text-brand-blue transition-colors" href="tel:8166008383">
        <span class="material-symbols-outlined text-sm text-brand-blue">call</span>
        <span>{clubInfo.phone}</span>
      </a>
      <span class="hidden sm:inline text-slate-600">•</span>
      <a class="flex items-center gap-1.5 hover:text-brand-blue transition-colors" href={`mailto:${clubInfo.email}`}>
        <span class="material-symbols-outlined text-sm text-brand-blue">mail</span>
        <span>{clubInfo.email}</span>
      </a>
    </div>

    <!-- Right Club Affiliations & Portals -->
    <div class="flex items-center gap-4 text-xs font-semibold">
      <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded bg-athletic-charcoal text-brand-blue text-[11px] tracking-wider uppercase border border-white/10">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-blue animate-pulse"></span>
        USAV HOA &amp; JVA REGISTERED
      </span>
      <div class="hidden lg:flex items-center gap-2 text-slate-400">
        <a aria-label="Facebook" class="hover:text-white transition-colors" href={clubInfo.socials.facebook} target="_blank" rel="noopener noreferrer">FB</a>
        <span>/</span>
        <a aria-label="Instagram" class="hover:text-white transition-colors" href={clubInfo.socials.instagram} target="_blank" rel="noopener noreferrer">IG</a>
      </div>
      <a class="inline-flex items-center gap-1 text-brand-blue hover:text-white font-bold transition-colors" href={clubInfo.tryoutRegistrationUrl} target="_blank" rel="noopener noreferrer">
        <span class="material-symbols-outlined text-xs">login</span>
        PARENT PORTAL
      </a>
    </div>
  </div>
</div>

<!-- Sticky Main Header -->
<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md shadow-sm border-b-2 border-brand-blue">
  <div class="max-w-7xl mx-auto flex items-center justify-between px-5 md:px-12 py-2.5">
    <!-- Authentic SVC Logo Only (No Text) -->
    <a class="flex items-center shrink-0 group" href="/" aria-label="Summit Volleyball Club Home">
      <img
        alt="Summit Volleyball Club Kansas City Logo"
        class="h-12 w-auto sm:h-14 rounded-md object-contain group-hover:scale-105 transition-transform"
        src="/images/logo.png"
      />
    </a>

    <!-- Desktop Navigation Links (Clean Plus Jakarta Sans Typography) -->
    <nav class="hidden lg:flex items-center gap-8 font-sans text-[14px] font-bold uppercase tracking-[0.06em]">
      <!-- TEAMS Mega Dropdown -->
      <div class="relative group">
        <a
          href="/teams"
          class:list={[
            'inline-flex items-center gap-1 py-2 transition-colors duration-150',
            isTeamsActive
              ? 'text-athletic-black border-b-2 border-brand-blue'
              : 'text-slate-700 group-hover:text-brand-blue-dark',
          ]}
        >
          <span>Teams</span>
          <span class="material-symbols-outlined text-base transition-transform duration-200 group-hover:rotate-180">expand_more</span>
        </a>

        <!-- Dropdown Panel -->
        <div class="invisible opacity-0 translate-y-1 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-150 absolute left-0 top-full pt-3 w-[680px] z-50">
          <div class="bg-white border border-slate-200 border-t-4 border-t-brand-blue rounded-sm shadow-2xl p-6">
            <!-- Top Banner inside Teams Dropdown: 17 National Bid Spotlight -->
            <a
              href="/teams#spotlight-17-national"
              class="mb-5 p-3 rounded-sm bg-athletic-black text-white flex items-center justify-between gap-4 hover:bg-athletic-charcoal transition-colors"
            >
              <div class="flex items-center gap-2.5">
                <span class="material-symbols-outlined text-brand-blue text-xl">emoji_events</span>
                <div>
                  <div class="text-[11px] font-extrabold uppercase tracking-wider text-brand-blue">FEATURED NATIONAL BID SPOTLIGHT</div>
                  <div class="text-xs font-bold text-white normal-case tracking-normal">SVC 17 National • 11-0 Undefeated MEQ Champions (120 Teams)</div>
                </div>
              </div>
              <span class="text-[11px] font-bold text-brand-blue uppercase tracking-wider shrink-0">View Spotlight →</span>
            </a>

            <div class="grid grid-cols-12 gap-6">
              <!-- Girls Teams (Cols 1-8) -->
              <div class="col-span-8">
                <div class="flex items-center justify-between border-b border-slate-200 pb-2 mb-3">
                  <span class="text-xs font-extrabold uppercase tracking-wider text-athletic-black">
                    Girls Club Teams (11U–18U)
                  </span>
                  <a href="/teams#girls" class="text-[11px] font-bold text-brand-blue-dark hover:underline">
                    View All 18 Girls Teams →
                  </a>
                </div>
                <div class="grid grid-cols-3 gap-x-3 gap-y-1.5 text-xs font-semibold normal-case tracking-normal">
                  {girlsTeams.map((team) => (
                    <a
                      href={`/teams/${team.slug}`}
                      class="py-1 px-2 rounded hover:bg-powder-50 text-slate-700 hover:text-athletic-black flex items-center justify-between group/item transition-colors"
                    >
                      <span>{team.name}</span>
                      <span class="text-[10px] font-bold text-slate-400 group-hover/item:text-brand-blue-dark">{team.tab}</span>
                    </a>
                  ))}
                </div>
              </div>

              <!-- Boys Teams & Programs (Cols 9-12) -->
              <div class="col-span-4 border-l border-slate-100 pl-5 flex flex-col justify-between">
                <div>
                  <div class="flex items-center justify-between border-b border-slate-200 pb-2 mb-3">
                    <span class="text-xs font-extrabold uppercase tracking-wider text-athletic-black">
                      Boys Club Teams
                    </span>
                  </div>
                  <div class="space-y-1.5 text-xs font-semibold normal-case tracking-normal">
                    {boysTeams.map((team) => (
                      <a
                        href={`/teams/${team.slug}`}
                        class="block py-1.5 px-2.5 rounded bg-surface-subtle hover:bg-powder-50 text-athletic-black border border-slate-200/80 transition-colors"
                      >
                        <div class="flex items-center justify-between">
                          <span class="font-bold">{team.name}</span>
                          <span class="text-[10px] font-extrabold text-brand-blue-dark">{team.tab}</span>
                        </div>
                        <div class="text-[10px] text-slate-500 font-semibold">{team.ageGroup} • Roster &amp; Schedule</div>
                      </a>
                    ))}
                  </div>
                </div>

                <div class="pt-4 border-t border-slate-100 mt-4">
                  <a
                    href="/teams"
                    class="flex items-center justify-center gap-1.5 w-full bg-brand-blue hover:bg-brand-blue-dark text-athletic-black py-2 px-3 rounded-sm text-xs font-extrabold uppercase tracking-wider transition-colors"
                  >
                    <span>Explore All 20 Teams</span>
                    <span class="material-symbols-outlined text-sm">arrow_forward</span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <a
        href="/tryouts"
        class:list={[
          'py-2 transition-colors duration-150',
          currentPath.startsWith('/tryouts')
            ? 'text-athletic-black border-b-2 border-brand-blue'
            : 'text-slate-700 hover:text-brand-blue-dark',
        ]}
      >
        Tryouts
      </a>

      <a
        href="/camps-clinics"
        class:list={[
          'py-2 transition-colors duration-150',
          currentPath.startsWith('/camps-clinics')
            ? 'text-athletic-black border-b-2 border-brand-blue'
            : 'text-slate-700 hover:text-brand-blue-dark',
        ]}
      >
        Camps &amp; Clinics
      </a>

      <!-- INFORMATION Dropdown -->
      <div class="relative group">
        <button
          type="button"
          class:list={[
            'inline-flex items-center gap-1 py-2 transition-colors duration-150 uppercase tracking-[0.06em] font-bold cursor-pointer',
            isInfoActive
              ? 'text-athletic-black border-b-2 border-brand-blue'
              : 'text-slate-700 group-hover:text-brand-blue-dark',
          ]}
        >
          <span>Information</span>
          <span class="material-symbols-outlined text-base transition-transform duration-200 group-hover:rotate-180">expand_more</span>
        </button>

        <div class="invisible opacity-0 translate-y-1 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-150 absolute right-0 top-full pt-3 w-72 z-50">
          <div class="bg-white border border-slate-200 border-t-4 border-t-brand-blue rounded-sm shadow-2xl py-2">
            {infoLinks.map((item) => (
              <a
                href={item.href}
                class="flex items-start gap-3 px-4 py-2.5 hover:bg-powder-50 transition-colors group/info"
              >
                <span class="material-symbols-outlined text-brand-blue-dark text-lg mt-0.5 group-hover/info:text-athletic-black transition-colors">
                  {item.icon}
                </span>
                <div class="normal-case tracking-normal">
                  <div class="text-xs font-extrabold uppercase tracking-wider text-athletic-black group-hover/info:text-brand-blue-dark">
                    {item.label}
                  </div>
                  <div class="text-[11px] text-slate-500 font-medium leading-snug">
                    {item.desc}
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </nav>

    <!-- Trailing Action CTA -->
    <div class="flex items-center gap-3">
      <a
        class="hidden sm:inline-flex items-center gap-2 bg-athletic-black hover:bg-athletic-charcoal text-white px-4 py-2.5 rounded-sm font-sans text-xs tracking-wider uppercase font-extrabold shadow hover:shadow-md border border-black transition-all active:translate-y-px"
        href="/tryouts"
      >
        <span>REGISTER FOR TRYOUTS</span>
        <span class="material-symbols-outlined text-sm text-brand-blue">arrow_forward</span>
      </a>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="Toggle Menu"
        class="lg:hidden p-2 rounded border border-slate-200 text-athletic-black hover:bg-slate-100"
      >
        <span class="material-symbols-outlined text-2xl">menu</span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-menu" class="hidden lg:hidden bg-white border-t border-slate-200 px-5 py-4 space-y-3 shadow-xl max-h-[82vh] overflow-y-auto">
    <div class="space-y-1 font-sans text-sm font-bold uppercase tracking-wider">
      <a href="/teams" class="block px-3 py-2 rounded text-athletic-black hover:bg-powder-50">Teams (Girls &amp; Boys)</a>
      <a href="/tryouts" class="block px-3 py-2 rounded text-athletic-black hover:bg-powder-50">Tryouts</a>
      <a href="/camps-clinics" class="block px-3 py-2 rounded text-athletic-black hover:bg-powder-50">Camps &amp; Clinics</a>
    </div>

    <!-- Mobile Teams Quick List -->
    <div class="pt-3 border-t border-slate-100">
      <div class="px-3 text-[11px] font-extrabold uppercase tracking-widest text-brand-blue-dark mb-2">
        Club Teams (2026–2027)
      </div>
      <div class="grid grid-cols-2 gap-1.5 px-3 text-xs font-semibold text-slate-700">
        {girlsTeams.map((t) => (
          <a href={`/teams/${t.slug}`} class="py-1 hover:text-brand-blue-dark">{t.name} ({t.tab})</a>
        ))}
        {boysTeams.map((t) => (
          <a href={`/teams/${t.slug}`} class="py-1 font-bold text-athletic-black hover:text-brand-blue-dark">{t.name} ({t.tab})</a>
        ))}
      </div>
    </div>

    <!-- Mobile Information Links -->
    <div class="pt-3 border-t border-slate-100">
      <div class="px-3 text-[11px] font-extrabold uppercase tracking-widest text-brand-blue-dark mb-2">
        Information
      </div>
      <div class="grid grid-cols-2 gap-1 px-3 text-xs font-bold uppercase tracking-wide text-athletic-black">
        {infoLinks.map((item) => (
          <a href={item.href} class="py-1.5 hover:text-brand-blue-dark flex items-center gap-1.5">
            <span class="material-symbols-outlined text-sm text-brand-blue-dark">{item.icon}</span>
            <span>{item.label}</span>
          </a>
        ))}
      </div>
    </div>

    <div class="pt-3 border-t border-slate-100">
      <a
        href="/tryouts"
        class="flex items-center justify-center gap-2 w-full bg-athletic-black text-white font-sans font-extrabold text-xs uppercase tracking-wider py-3 rounded-sm shadow"
      >
        <span>REGISTER FOR TRYOUTS</span>
        <span class="material-symbols-outlined text-sm text-brand-blue">arrow_forward</span>
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
