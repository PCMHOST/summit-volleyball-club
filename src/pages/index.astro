---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  clubInfo,
  collegeCommits,
  coachesList,
} from '../data/clubData';

const featuredCoaches = coachesList.slice(0, 5);
const matchPointVideoUrl = "https://cdn4.sportngin.com/attachments/video_file/81c7-503085/SVC_16-1_girls_final_point_at_Regionals_031024_1080.mp4";
---

<BaseLayout>
  <!-- ========================================================= -->
  <!-- 2. FULL-WIDTH ACTION HERO BANNER (Carolina Blue / Black / White Triad) -->
  <!-- ========================================================= -->
  <section class="relative bg-athletic-black text-white overflow-hidden min-h-[600px] lg:min-h-[680px] flex items-center border-b-4 border-brand-blue">
    <!-- Action Imagery Background & Atmospheric Gradients -->
    <div class="absolute inset-0 z-0">
      <img
        class="w-full h-full object-cover object-center opacity-35 mix-blend-luminosity filter contrast-125"
        alt="Summit Volleyball Club athletes in action during a competitive national tournament match"
        src="/images/facility/tm-volleyball-courts.jpg"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-athletic-black via-athletic-black/90 to-athletic-black/65"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-brand-blue/25 via-transparent to-transparent"></div>
    </div>

    <!-- Main Content Container -->
    <div class="relative z-10 max-w-7xl mx-auto px-5 md:px-12 py-14 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <!-- Left 7 Cols: Headline & CTAs -->
        <div class="lg:col-span-7 space-y-5">
          <!-- Prominent Season Badge -->
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-sm bg-brand-blue/20 text-brand-blue border border-brand-blue/50 backdrop-blur-sm">
            <span class="material-symbols-outlined text-sm font-bold text-brand-blue">bolt</span>
            <span class="font-display text-sm uppercase tracking-wider font-extrabold">
              2026–2027 CLUB SEASON • REGISTRATION NOW OPEN
            </span>
          </div>

          <!-- Headline Stack with Athletic Stroke Outlines -->
          <div class="space-y-1">
            <h2 class="stroke-athletic-blue font-display text-5xl sm:text-7xl md:text-[5rem] leading-[0.95] tracking-wider uppercase font-extrabold select-none">
              REACH THE SUMMIT
            </h2>
            <h1 class="font-display text-4xl sm:text-5xl md:text-[3.35rem] text-white uppercase leading-[1.05] font-black tracking-wide">
              ELEVATING YOUTH VOLLEYBALL IN KANSAS CITY
            </h1>
          </div>

          <!-- Subheadline -->
          <p class="text-base sm:text-lg text-slate-200 max-w-2xl font-normal leading-relaxed">
            20 Competitive Girls &amp; Boys Teams (Ages 11–18) • Exclusively Training at TM Fieldhouse in Lee's Summit, MO. Comprehensive player development, elite recruiting exposure, and championship culture.
          </p>

          <!-- Dual Call-to-Actions -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
            <a
              class="inline-flex justify-center items-center gap-2 bg-brand-blue hover:bg-brand-blue-dark text-athletic-black px-7 py-3.5 rounded-sm font-display text-2xl tracking-wider uppercase font-black shadow-lg transition-all active:translate-y-px"
              href="/tryouts"
            >
              <span>2026–2027 TRYOUT SCHEDULE</span>
              <span class="material-symbols-outlined text-xl">chevron_right</span>
            </a>
            <a
              class="inline-flex justify-center items-center gap-2 bg-white/10 hover:bg-white hover:text-athletic-black text-white border-2 border-white backdrop-blur-sm px-6 py-3.5 rounded-sm font-display text-2xl tracking-wider uppercase font-bold transition-all"
              href="/teams"
            >
              <span>EXPLORE 20 TEAMS</span>
            </a>
          </div>
        </div>

        <!-- Right 5 Cols: Multi-Image Hero Showcase Collage -->
        <div class="lg:col-span-5 grid grid-cols-2 gap-3.5">
          <div class="col-span-2 relative rounded-sm overflow-hidden border-2 border-brand-blue/60 shadow-2xl group aspect-16/10 bg-black">
            <img
              src="/images/teams/17-national-meq.jpg"
              alt="SVC 17 National 11-0 Undefeated MEQ Champions"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent"></div>
            <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between">
              <div>
                <span class="bg-brand-blue text-athletic-black px-2 py-0.5 rounded-xs font-display text-[11px] font-black uppercase tracking-wider">
                  NATIONAL QUALIFIERS
                </span>
                <div class="font-display text-lg font-black uppercase text-white mt-0.5">
                  SVC 17 National • 11-0 MEQ Champions
                </div>
              </div>
            </div>
          </div>

          <div class="relative rounded-sm overflow-hidden border border-white/25 shadow-xl group aspect-4/3 bg-black">
            <img
              src="/images/teams/18-boys-bid.jpg"
              alt="SVC Boys 18-1 National Bid Winners"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-transparent to-transparent"></div>
            <div class="absolute bottom-2.5 left-2.5 right-2.5">
              <div class="text-[10px] font-extrabold uppercase tracking-wider text-brand-blue">3X USAV NATIONAL BIDS</div>
              <div class="font-display text-sm font-black uppercase text-white leading-tight">SVC Boys Program</div>
            </div>
          </div>

          <div class="relative rounded-sm overflow-hidden border border-white/25 shadow-xl group aspect-4/3 bg-black">
            <img
              src="/images/facility/tm-courts-wide.jpg"
              alt="TM Fieldhouse Home of Summit Volleyball Club"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-transparent to-transparent"></div>
            <div class="absolute bottom-2.5 left-2.5 right-2.5">
              <div class="text-[10px] font-extrabold uppercase tracking-wider text-brand-blue">LEE'S SUMMIT HOME</div>
              <div class="font-display text-sm font-black uppercase text-white leading-tight">TM Fieldhouse Courts</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Trust Badge Bar along Hero Bottom -->
      <div class="mt-10 pt-6 border-t border-white/15 grid grid-cols-2 md:grid-cols-4 gap-4 text-xs font-semibold uppercase tracking-wider text-slate-300">
        <div class="flex items-center gap-2">
          <span class="text-brand-blue font-black text-sm">✦</span>
          <span>3x Consecutive USA National Bids</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-brand-blue font-black text-sm">✦</span>
          <span>40+ Collegiate Alumni</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-brand-blue font-black text-sm">✦</span>
          <span>Exclusive Training at TM Fieldhouse</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-brand-blue font-black text-sm">✦</span>
          <span>USAV HOA Regional Powerhouse</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================= -->
  <!-- 3. "GET STARTED" INTERACTIVE PROGRAM GRID                 -->
  <!-- ========================================================= -->
  <section class="py-14 bg-white border-b border-slate-200" id="programs">
    <div class="max-w-7xl mx-auto px-5 md:px-12">
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto mb-12 space-y-2">
        <span class="font-display text-xl uppercase tracking-wider font-extrabold text-brand-blue-dark">
          CHOOSE YOUR PATH
        </span>
        <h2 class="font-display text-4xl md:text-[3.5rem] leading-[1.05] text-athletic-black font-black uppercase tracking-tight">
          COMPETITIVE &amp; DEVELOPMENTAL PROGRAMS
        </h2>
        <p class="text-base text-slate-600">
          From developmental grass-roots to national open qualifier podiums, Summit equips Kansas City volleyball athletes with the competitive edge to succeed.
        </p>
      </div>

      <!-- 4 Tall Visual Cards Bento Grid: Girls, Boys, Camps & Clinics, Tryouts -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Card 1: GIRLS CLUB PROGRAM -->
        <div class="group relative flex flex-col justify-between bg-white border border-slate-200 rounded-sm overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-200">
          <div class="relative h-60 overflow-hidden bg-athletic-black">
            <img
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              alt="SVC Girls Club Program"
              src="/images/teams/17-1-girls.jpg"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-athletic-black via-athletic-black/50 to-transparent"></div>
            <div class="absolute top-3 left-3 bg-brand-blue text-athletic-black px-2.5 py-1 text-xs font-display uppercase tracking-wider font-black rounded-sm shadow-sm">
              AGES 10–18 • 19 TEAMS
            </div>
            <div class="absolute bottom-3 left-4 right-4">
              <h3 class="font-display text-[1.75rem] uppercase text-white font-extrabold tracking-wide leading-none">
                GIRLS CLUB PROGRAM
              </h3>
              <p class="text-xs text-brand-blue uppercase font-semibold mt-1">National, Premier &amp; Select</p>
            </div>
          </div>
          <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
            <ul class="space-y-2.5 text-xs text-slate-600 font-medium">
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-brand-blue-dark text-base shrink-0">check_circle</span>
                <span>Multi-day national travel tournaments &amp; USAV qualifiers</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-brand-blue-dark text-base shrink-0">check_circle</span>
                <span>Master positional coaching &amp; game film breakdown</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-brand-blue-dark text-base shrink-0">check_circle</span>
                <span>Whole-athlete nutrition, PT, agility &amp; mindset support</span>
              </li>
            </ul>
            <a
              class="inline-flex items-center justify-between text-athletic-black hover:text-brand-blue-dark font-display text-lg uppercase font-extrabold pt-3 border-t border-slate-100 group-hover:underline"
              href="/teams#girls"
            >
              <span>Explore Girls Teams</span>
              <span class="material-symbols-outlined text-base group-hover:translate-x-1 transition-transform">arrow_forward</span>
            </a>
          </div>
        </div>

        <!-- Card 2: BOYS CLUB PROGRAM -->
        <div class="group relative flex flex-col justify-between bg-white border border-slate-200 rounded-sm overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-200">
          <div class="relative h-60 overflow-hidden bg-athletic-black">
            <img
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              alt="SVC Boys Club Program"
              src="/images/teams/18-boys-bid.jpg"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-athletic-black via-athletic-black/50 to-transparent"></div>
            <div class="absolute top-3 left-3 bg-white text-athletic-black font-black px-2.5 py-1 text-xs font-display uppercase tracking-wider rounded-sm shadow-sm border border-slate-200">
              NATIONAL BID WINNERS
            </div>
            <div class="absolute bottom-3 left-4 right-4">
              <h3 class="font-display text-[1.75rem] uppercase text-white font-extrabold tracking-wide leading-none">
                BOYS CLUB PROGRAM
              </h3>
              <p class="text-xs text-brand-blue uppercase font-semibold mt-1">Ages 14–18 • 15U–18U Divisions</p>
            </div>
          </div>
          <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
            <ul class="space-y-2.5 text-xs text-slate-600 font-medium">
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-brand-blue-dark text-base shrink-0">check_circle</span>
                <span>Fastest growing competitive boys volleyball hub in KC</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-brand-blue-dark text-base shrink-0">check_circle</span>
                <span>USAV Boys Junior Nationals qualifiers &amp; HOA champs</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-brand-blue-dark text-base shrink-0">check_circle</span>
                <span>High-intensity power and jump conditioning</span>
              </li>
            </ul>
            <a
              class="inline-flex items-center justify-between text-athletic-black hover:text-brand-blue-dark font-display text-lg uppercase font-extrabold pt-3 border-t border-slate-100 group-hover:underline"
              href="/teams#boys"
            >
              <span>Explore Boys Teams</span>
              <span class="material-symbols-outlined text-base group-hover:translate-x-1 transition-transform">arrow_forward</span>
            </a>
          </div>
        </div>

        <!-- Card 3: CAMPS & CLINICS -->
        <div class="group relative flex flex-col justify-between bg-white border border-slate-200 rounded-sm overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-200">
          <div class="relative h-60 overflow-hidden bg-athletic-black">
            <img
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              alt="SVC Camps and Clinics"
              src="/images/gallery/action-2.jpg"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-athletic-black via-athletic-black/50 to-transparent"></div>
            <div class="absolute top-3 left-3 bg-brand-blue text-athletic-black px-2.5 py-1 text-xs font-display uppercase tracking-wider font-black rounded-sm shadow-sm">
              YEAR-ROUND SKILLS
            </div>
            <div class="absolute bottom-3 left-4 right-4">
              <h3 class="font-display text-[1.75rem] uppercase text-white font-extrabold tracking-wide leading-none">
                CAMPS &amp; CLINICS
              </h3>
              <p class="text-xs text-brand-blue uppercase font-semibold mt-1">Positional Academies &amp; Open Gyms</p>
            </div>
          </div>
          <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
            <ul class="space-y-2.5 text-xs text-slate-600 font-medium">
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-brand-blue-dark text-base shrink-0">check_circle</span>
                <span>Pre-tryout tune-ups and open gym positional drills</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-brand-blue-dark text-base shrink-0">check_circle</span>
                <span>Setters, Hitters &amp; Libero technical academies</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-brand-blue-dark text-base shrink-0">check_circle</span>
                <span>Pass &amp; serve pressure clinics for rapid skill leap</span>
              </li>
            </ul>
            <a
              class="inline-flex items-center justify-between text-athletic-black hover:text-brand-blue-dark font-display text-lg uppercase font-extrabold pt-3 border-t border-slate-100 group-hover:underline"
              href="/camps-clinics"
            >
              <span>View Camps &amp; Clinics</span>
              <span class="material-symbols-outlined text-base group-hover:translate-x-1 transition-transform">arrow_forward</span>
            </a>
          </div>
        </div>

        <!-- Card 4: TRYOUTS -->
        <div class="group relative flex flex-col justify-between bg-white border border-slate-200 rounded-sm overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-200">
          <div class="relative h-60 overflow-hidden bg-athletic-black">
            <img
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              alt="SVC 2026-2027 Season Tryouts"
              src="/images/gallery/action-4.jpg"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-athletic-black via-athletic-black/50 to-transparent"></div>
            <div class="absolute top-3 left-3 bg-athletic-black text-brand-blue px-2.5 py-1 text-xs font-display uppercase tracking-wider font-black rounded-sm border border-brand-blue/40">
              2026–2027 SEASON
            </div>
            <div class="absolute bottom-3 left-4 right-4">
              <h3 class="font-display text-[1.75rem] uppercase text-white font-extrabold tracking-wide leading-none">
                CLUB TRYOUTS
              </h3>
              <p class="text-xs text-brand-blue uppercase font-semibold mt-1">July 11–12 (Girls) &amp; July 25–26 (Boys)</p>
            </div>
          </div>
          <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
            <ul class="space-y-2.5 text-xs text-slate-600 font-medium">
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-brand-blue-dark text-base shrink-0">check_circle</span>
                <span>Girls 11U–18U &amp; Boys 15U–18U evaluation sessions</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-brand-blue-dark text-base shrink-0">check_circle</span>
                <span>Held exclusively at TM Fieldhouse in Lee's Summit</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-brand-blue-dark text-base shrink-0">check_circle</span>
                <span>Select mid-season roster openings also available</span>
              </li>
            </ul>
            <a
              class="inline-flex items-center justify-between text-athletic-black hover:text-brand-blue-dark font-display text-lg uppercase font-extrabold pt-3 border-t border-slate-100 group-hover:underline"
              href="/tryouts"
            >
              <span>View Tryout Schedule</span>
              <span class="material-symbols-outlined text-base group-hover:translate-x-1 transition-transform">arrow_forward</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================= -->
  <!-- 4. "NATIONAL BID WINNERS & QUALIFICATIONS" (Sleek Athletic Black Section) -->
  <!-- ========================================================= -->
  <section class="relative py-14 bg-athletic-black text-white overflow-hidden" id="qualifications">
    <!-- Atmospheric Carolina blue glow accents -->
    <div class="absolute top-0 right-0 w-96 h-96 bg-brand-blue/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-brand-blue/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-5 md:px-12 relative z-10">
      <!-- Section Header -->
      <div class="text-center max-w-4xl mx-auto mb-14 space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-white/10 text-brand-blue rounded-sm border border-brand-blue/30">
          <span class="material-symbols-outlined text-sm">emoji_events</span>
          <span class="font-display text-sm uppercase tracking-wider font-black">CHAMPIONSHIP CULTURE</span>
        </div>
        <h2 class="font-display text-4xl md:text-[3.5rem] leading-[1.05] font-black uppercase tracking-tight text-white">
          PROVEN AT THE HIGHEST LEVEL: NATIONAL QUALIFICATIONS
        </h2>
        <div class="stroke-athletic-blue font-display text-3xl md:text-[2.5rem] font-black uppercase tracking-widest">
          SUMMIT EXCELLENCE
        </div>
      </div>

      <!-- Key Stat Counters Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 md:gap-6 mb-12">
        <div class="bg-athletic-charcoal/90 border border-white/10 p-6 rounded-sm text-center">
          <div class="font-display text-5xl md:text-[4rem] leading-none text-brand-blue font-black">20</div>
          <div class="font-display text-xl text-white uppercase font-bold tracking-wider mt-1">COMPETITIVE TEAMS</div>
          <p class="text-xs text-slate-400 mt-1">Boys &amp; Girls USAV Rosters</p>
        </div>
        <div class="bg-athletic-charcoal/90 border border-white/10 p-6 rounded-sm text-center">
          <div class="font-display text-5xl md:text-[4rem] leading-none text-white font-black">3x</div>
          <div class="font-display text-xl text-white uppercase font-bold tracking-wider mt-1">CONSECUTIVE 18 BIDS</div>
          <p class="text-xs text-slate-400 mt-1">USA National Championships</p>
        </div>
        <div class="bg-athletic-charcoal/90 border border-white/10 p-6 rounded-sm text-center">
          <div class="font-display text-5xl md:text-[4rem] leading-none text-brand-blue font-black">11-0</div>
          <div class="font-display text-xl text-white uppercase font-bold tracking-wider mt-1">17 NATL UNDEFEATED</div>
          <p class="text-xs text-slate-400 mt-1">Mideast Qualifier Champions</p>
        </div>
      </div>

      <!-- 3-Column Featured Qualification Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
        <!-- Card 1 -->
        <div class="bg-athletic-charcoal border-t-4 border-brand-blue rounded-sm overflow-hidden flex flex-col justify-between shadow-lg">
          <div class="h-44 overflow-hidden relative">
            <img src="/images/teams/18-national-girls.jpg" alt="SVC 18 National Girls" class="w-full h-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-t from-athletic-charcoal via-transparent to-transparent"></div>
          </div>
          <div class="p-6 flex-1 flex flex-col justify-between">
            <div class="space-y-3">
              <span class="inline-block bg-brand-blue/20 text-brand-blue px-2.5 py-1 text-xs font-display font-bold uppercase tracking-wider rounded-sm border border-brand-blue/30">
                USA NATIONAL BID • USAV GJNC
              </span>
              <h3 class="font-display text-[1.75rem] uppercase text-white font-black leading-tight">
                3RD YEAR IN A ROW! SVC 18 National Earns Bid to Nationals in Reno!
              </h3>
              <p class="text-sm text-slate-300 leading-relaxed">
                Battled through elite national squads in intense gold-bracket competition to punch their ticket to USA Volleyball Junior Nationals for the third consecutive season.
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-white/10 flex items-center justify-between text-xs text-slate-300 font-bold">
              <span>DIVISION: 18 NATIONAL</span>
              <span class="text-brand-blue font-black">RENO, NV QUALIFIED</span>
            </div>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="bg-athletic-charcoal border-t-4 border-white rounded-sm overflow-hidden flex flex-col justify-between shadow-lg">
          <div class="h-44 overflow-hidden relative">
            <img src="/images/teams/18-boys-bid.jpg" alt="SVC 18 Boys National Bid" class="w-full h-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-t from-athletic-charcoal via-transparent to-transparent"></div>
          </div>
          <div class="p-6 flex-1 flex flex-col justify-between">
            <div class="space-y-3">
              <span class="inline-block bg-white/15 text-white px-2.5 py-1 text-xs font-display font-bold uppercase tracking-wider rounded-sm border border-white/20">
                BOYS JUNIOR NATIONALS QUALIFIER
              </span>
              <h3 class="font-display text-[1.75rem] uppercase text-white font-black leading-tight">
                SVC 18 BOYS EARN USA NATIONAL BID!
              </h3>
              <p class="text-sm text-slate-300 leading-relaxed">
                SVC 18-1 Boys capture national bid with an electric gold-bracket finish, cementing Summit's top-tier status in Midwest boys competitive volleyball.
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-white/10 flex items-center justify-between text-xs text-slate-300 font-bold">
              <span>DIVISION: 18 BOYS OPEN</span>
              <span class="text-brand-blue font-black">DALLAS, TX BOUND</span>
            </div>
