---
import BaseLayout from '../layouts/BaseLayout.astro';
import { clubInfo } from '../data/clubData';

const matchPointVideoUrl = "https://cdn4.sportngin.com/attachments/video_file/81c7-503085/SVC_16-1_girls_final_point_at_Regionals_031024_1080.mp4";

const amenities = [
  {
    title: "Championship Volleyball Courts",
    icon: "grid_on",
    desc: "Dedicated multi-court indoor training environment engineered for high-level volleyball practices, open gyms, and positional clinics."
  },
  {
    title: "Strength, Plyometric & Jump Zone",
    icon: "fitness_center",
    desc: "Dedicated athletic performance space for vertical jump training, lateral agility work, and our KC Rehab & Wellness injury-prevention warm-ups."
  },
  {
    title: "Elevated Spectator Mezzanine",
    icon: "chair",
    desc: "Comfortable viewing areas for parents, families, and college scouts to watch practices, scrimmages, and seasonal leagues."
  },
  {
    title: "Live Court Video & Film Breakdown",
    icon: "videocam",
    desc: "Equipped for match streaming, recruiting highlight capture, and technical coaching film analysis."
  }
];
---

<BaseLayout title="Our Facility: TM Fieldhouse | Summit Volleyball Club">
  <!-- Hero -->
  <section class="bg-athletic-black text-white py-14 md:py-20 border-b-4 border-brand-blue relative overflow-hidden">
    <div class="absolute top-0 right-0 w-96 h-96 bg-brand-blue/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-5 md:px-12 relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-sm bg-brand-blue/20 text-brand-blue border border-brand-blue/40 text-xs font-extrabold uppercase tracking-wider mb-3">
        <span class="material-symbols-outlined text-sm">stadium</span>
        <span>EXCLUSIVE TRAINING HOME OF SUMMIT VOLLEYBALL CLUB</span>
      </div>
      <h1 class="font-display text-4xl sm:text-6xl font-black uppercase tracking-tight leading-none">
        OUR FACILITY: <span class="text-brand-blue">TM FIELDHOUSE</span>
      </h1>
      <p class="text-base sm:text-lg text-slate-300 max-w-2xl mt-3">
        All Summit Volleyball Club practices, tryouts, open gyms, and positional clinics are held exclusively at TM Fieldhouse in Lee's Summit, MO.
      </p>
    </div>
  </section>

  <!-- Main Facility Showcase -->
  <section class="py-14 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-5 md:px-12 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left Info -->
      <div class="lg:col-span-6 space-y-6">
        <div>
          <span class="font-display text-xl uppercase tracking-wider font-extrabold text-brand-blue-dark">
            LEE'S SUMMIT, MISSOURI
          </span>
          <h2 class="font-display text-4xl font-black uppercase text-athletic-black mt-1">
            BUILT FOR ELITE PLAYER DEVELOPMENT
          </h2>
        </div>
        <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
          Having a consistent, premier home facility is a game-changer for our families. Rather than bouncing between distant gyms across the metro, Summit Volleyball Club athletes train under one roof at <strong class="text-athletic-black">TM Fieldhouse</strong> ({clubInfo.facility.fullAddress}).
        </p>

        <!-- Location Card -->
        <div class="bg-surface-subtle border border-slate-200 p-6 rounded-sm space-y-3">
          <div class="flex items-start gap-3">
            <span class="material-symbols-outlined text-brand-blue-dark text-2xl mt-0.5">location_on</span>
            <div>
              <div class="font-display text-2xl font-black uppercase text-athletic-black">
                {clubInfo.facility.name}
              </div>
              <div class="text-sm font-semibold text-slate-700">{clubInfo.facility.address}</div>
              <div class="text-sm font-semibold text-slate-700">{clubInfo.facility.city}</div>
            </div>
          </div>
          <div class="pt-3 border-t border-slate-200 flex flex-wrap gap-3">
            <a
              href={clubInfo.facility.mapUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 bg-athletic-black hover:bg-athletic-charcoal text-white px-4 py-2 rounded-sm font-display text-base uppercase font-bold tracking-wider transition-colors"
            >
              <span class="material-symbols-outlined text-sm text-brand-blue">directions</span>
              <span>Get Google Maps Directions</span>
            </a>
            <a
              href="/tryouts"
              class="inline-flex items-center gap-1.5 bg-brand-blue hover:bg-brand-blue-dark text-athletic-black px-4 py-2 rounded-sm font-display text-base uppercase font-black tracking-wider transition-colors"
            >
              <span>Upcoming Tryouts at TM Fieldhouse</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Right Video & Photo -->
      <div class="lg:col-span-6 space-y-4">
        <div class="rounded-sm overflow-hidden border border-slate-200 bg-athletic-black shadow-xl">
          <video
            controls
            preload="metadata"
            poster="/images/teams/16-boys-regionals.jpg"
            class="w-full h-80 object-cover"
          >
            <source src={matchPointVideoUrl} type="video/mp4" />
          </video>
          <div class="px-4 py-3 bg-athletic-black text-white text-xs flex items-center justify-between">
            <span class="font-bold">SVC Championship Action</span>
            <span class="text-brand-blue font-extrabold uppercase">TM Fieldhouse Home Turf</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 Amenities Grid -->
  <section class="py-14 bg-surface-subtle">
    <div class="max-w-7xl mx-auto px-5 md:px-12">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {amenities.map((item) => (
          <div class="bg-white border border-slate-200 p-6 rounded-sm shadow-xs space-y-3">
            <div class="w-11 h-11 rounded-sm bg-athletic-black text-brand-blue flex items-center justify-center">
              <span class="material-symbols-outlined text-2xl">{item.icon}</span>
            </div>
            <h3 class="font-display text-2xl font-black uppercase text-athletic-black leading-tight">
              {item.title}
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              {item.desc}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
