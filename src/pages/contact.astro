---
import BaseLayout from '../layouts/BaseLayout.astro';
import { clubInfo } from '../data/clubData';
---

<BaseLayout title="Contact Us | Summit Volleyball Club">
  <!-- Hero -->
  <section class="bg-athletic-black text-white py-14 md:py-20 border-b-4 border-brand-blue relative overflow-hidden">
    <div class="absolute top-0 right-0 w-96 h-96 bg-brand-blue/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-5 md:px-12 relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-sm bg-brand-blue/20 text-brand-blue border border-brand-blue/40 text-xs font-extrabold uppercase tracking-wider mb-3">
        <span class="material-symbols-outlined text-sm">mail</span>
        <span>WE'RE HERE TO HELP YOUR ATHLETE REACH THE SUMMIT</span>
      </div>
      <h1 class="font-display text-4xl sm:text-6xl font-black uppercase tracking-tight leading-none">
        CONTACT <span class="text-brand-blue">SUMMIT VOLLEYBALL CLUB</span>
      </h1>
      <p class="text-base sm:text-lg text-slate-300 max-w-2xl mt-3">
        Have questions about 2026–2027 tryouts, age divisions, roster openings, or sponsorships? Reach out directly to our Club Director and staff.
      </p>
    </div>
  </section>

  <!-- Contact Details & Inquiry Form -->
  <section class="py-14 bg-surface-subtle">
    <div class="max-w-7xl mx-auto px-5 md:px-12 grid grid-cols-1 lg:grid-cols-12 gap-10">
      <!-- Left Column: Direct Contact Cards -->
      <div class="lg:col-span-5 space-y-4">
        <div class="bg-white border border-slate-200 p-6 rounded-sm shadow-xs space-y-4">
          <div class="text-xs font-extrabold uppercase tracking-wider text-brand-blue-dark">DIRECT CLUB CONTACT</div>
          <h2 class="font-display text-3xl font-black uppercase text-athletic-black">
            CLUB LEADERSHIP &amp; GYM LOCATION
          </h2>

          <div class="space-y-4 pt-2 text-sm">
            <div class="flex items-start gap-3">
              <div class="w-9 h-9 rounded-sm bg-athletic-black text-brand-blue flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-lg">person</span>
              </div>
              <div>
                <div class="text-xs font-bold uppercase text-slate-400">Club Director</div>
                <div class="font-bold text-athletic-black">{clubInfo.director}</div>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-9 h-9 rounded-sm bg-athletic-black text-brand-blue flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-lg">call</span>
              </div>
              <div>
                <div class="text-xs font-bold uppercase text-slate-400">Phone / Text</div>
                <a href="tel:8166008383" class="font-bold text-athletic-black hover:text-brand-blue-dark underline">
                  {clubInfo.phone}
                </a>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-9 h-9 rounded-sm bg-athletic-black text-brand-blue flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-lg">mail</span>
              </div>
              <div>
                <div class="text-xs font-bold uppercase text-slate-400">Email</div>
                <a href={`mailto:${clubInfo.email}`} class="font-bold text-athletic-black hover:text-brand-blue-dark underline">
                  {clubInfo.email}
                </a>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-9 h-9 rounded-sm bg-athletic-black text-brand-blue flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-lg">stadium</span>
              </div>
              <div>
                <div class="text-xs font-bold uppercase text-slate-400">Practice &amp; Tryout Facility</div>
                <div class="font-bold text-athletic-black">{clubInfo.facility.name}</div>
                <div class="text-xs text-slate-600">{clubInfo.facility.fullAddress}</div>
                <a href={clubInfo.facility.mapUrl} target="_blank" rel="noopener noreferrer" class="text-xs font-bold text-brand-blue-dark hover:underline">
                  Open in Google Maps →
                </a>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-9 h-9 rounded-sm bg-athletic-black text-brand-blue flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-lg">markunread_mailbox</span>
              </div>
              <div>
                <div class="text-xs font-bold uppercase text-slate-400">Club Mailing Address</div>
                <div class="text-xs font-semibold text-slate-700">{clubInfo.mailingAddress}</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Venmo & Registration Box -->
        <div class="bg-athletic-black text-white p-6 rounded-sm border-l-4 border-brand-blue space-y-2">
          <div class="text-xs font-extrabold uppercase tracking-wider text-brand-blue">TRYOUT &amp; CLINIC PRE-REGISTRATION</div>
          <p class="text-xs text-slate-300 leading-relaxed">
            Pre-registering for tryouts or summer open gyms? Complete our online Google Form and submit the $10 session fee via Venmo <strong class="text-white">{clubInfo.venmo}</strong> or cash at check-in.
          </p>
          <div class="pt-2">
            <a
              href={clubInfo.tryoutRegistrationUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 bg-brand-blue hover:bg-brand-blue-dark text-athletic-black px-4 py-2 rounded-sm font-display text-base font-black uppercase tracking-wider"
            >
              <span>Open Tryout Registration Form</span>
              <span class="material-symbols-outlined text-sm">arrow_forward</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Right Column: Quick Message Form -->
      <div class="lg:col-span-7">
        <div class="bg-white border border-slate-200 rounded-sm p-7 md:p-9 shadow-xs">
          <h2 class="font-display text-3xl font-black uppercase text-athletic-black mb-1">
            SEND US A MESSAGE
          </h2>
          <p class="text-xs text-slate-500 mb-6">
            Fill out the form below to compose an inquiry directly to our Summit Volleyball Club leadership team.
          </p>

          <form
            action={`mailto:${clubInfo.email}`}
            method="get"
            enctype="text/plain"
            class="space-y-4"
          >
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-extrabold uppercase tracking-wider text-athletic-black mb-1">
                  Parent / Athlete Name *
                </label>
                <input
                  type="text"
                  name="name"
                  required
                  placeholder="Your full name"
                  class="w-full px-3.5 py-2.5 text-sm border border-slate-300 rounded-sm focus:outline-none focus:border-brand-blue-dark"
                />
              </div>
              <div>
                <label class="block text-xs font-extrabold uppercase tracking-wider text-athletic-black mb-1">
                  Phone Number *
                </label>
                <input
                  type="tel"
                  name="phone"
                  required
                  placeholder="816-000-0000"
                  class="w-full px-3.5 py-2.5 text-sm border border-slate-300 rounded-sm focus:outline-none focus:border-brand-blue-dark"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-extrabold uppercase tracking-wider text-athletic-black mb-1">
                  Athlete Age Division
                </label>
                <select
                  name="subject"
                  class="w-full px-3.5 py-2.5 text-sm border border-slate-300 rounded-sm focus:outline-none focus:border-brand-blue-dark bg-white"
                >
                  <option value="General Inquiry - Summit Volleyball Club">General Club Question</option>
                  <option value="Girls Tryout Inquiry (11U-18U)">Girls Tryouts (11U–18U)</option>
                  <option value="Boys Tryout / Open Gym Inquiry (15U-18U)">Boys Tryouts &amp; Open Gyms (15U–18U)</option>
                  <option value="Roster Opening Inquiry">Current Roster Opening Inquiry</option>
                  <option value="Camps & Clinics Question">Camps, Clinics &amp; Private Lessons</option>
                  <option value="Sponsorship Partnership Inquiry">Sponsorship &amp; Community Partnership</option>
                  <option value="College Recruiting Inquiry">College Recruiting Coordinator</option>
                </select>
              </div>
              <div>
                <label class="block text-xs font-extrabold uppercase tracking-wider text-athletic-black mb-1">
                  Email Address *
                </label>
                <input
                  type="email"
                  name="email"
                  required
                  placeholder="you@example.com"
                  class="w-full px-3.5 py-2.5 text-sm border border-slate-300 rounded-sm focus:outline-none focus:border-brand-blue-dark"
                />
              </div>
            </div>

            <div>
              <label class="block text-xs font-extrabold uppercase tracking-wider text-athletic-black mb-1">
                How Can We Help? *
              </label>
              <textarea
                name="body"
                rows="5"
                required
                placeholder="Tell us about your athlete's age group, position, or question..."
                class="w-full px-3.5 py-2.5 text-sm border border-slate-300 rounded-sm focus:outline-none focus:border-brand-blue-dark"
              ></textarea>
            </div>

            <button
              type="submit"
              class="inline-flex items-center justify-center gap-2 w-full sm:w-auto bg-athletic-black hover:bg-athletic-charcoal text-white px-8 py-3 rounded-sm font-display text-xl uppercase font-black tracking-wider transition-colors cursor-pointer"
            >
              <span>SEND MESSAGE TO SVC</span>
              <span class="material-symbols-outlined text-base text-brand-blue">send</span>
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
