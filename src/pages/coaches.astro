---
import BaseLayout from '../layouts/BaseLayout.astro';
import { coachesList, clubInfo } from '../data/clubData';
---

<BaseLayout title="2026–2027 Coaching Staff | Summit Volleyball Club">
  <!-- Hero Header with Background & Staff Collage -->
  <section class="bg-athletic-black text-white py-14 md:py-20 border-b-4 border-brand-blue relative overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src="/images/gallery/action-6.jpg"
        alt="Summit Volleyball Club Coaches and Athletes"
        class="w-full h-full object-cover object-center opacity-25"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-athletic-black via-athletic-black/90 to-athletic-black/65"></div>
    </div>
    <div class="max-w-7xl mx-auto px-5 md:px-12 relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-7">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-sm bg-brand-blue/20 text-brand-blue border border-brand-blue/40 text-xs font-extrabold uppercase tracking-wider mb-3">
          <span class="material-symbols-outlined text-sm">groups</span>
          <span>EXPERIENCED COLLEGIATE &amp; USAV CERTIFIED INSTRUCTORS</span>
        </div>
        <h1 class="font-display text-4xl sm:text-6xl font-black uppercase tracking-tight leading-none">
          2026–2027 <span class="text-brand-blue">COACHING STAFF</span>
        </h1>
        <p class="text-base sm:text-lg text-slate-200 max-w-2xl mt-3">
          Meet the dedicated head and assistant coaches leading Summit Volleyball Club's 2026–2027 Girls and Boys teams at TM Fieldhouse.
        </p>
      </div>
      <div class="lg:col-span-5 grid grid-cols-2 gap-3">
        <div class="rounded-sm overflow-hidden border-2 border-brand-blue/50 shadow-xl aspect-4/3 bg-black">
          <img src="/images/gallery/action-4.jpg" alt="SVC Coaches with Team at the Net" class="w-full h-full object-cover" />
        </div>
        <div class="rounded-sm overflow-hidden border-2 border-white/20 shadow-xl aspect-4/3 bg-black">
          <img src="/images/gallery/action-5.jpg" alt="SVC Coaching Staff & Medalist Squad" class="w-full h-full object-cover" />
        </div>
      </div>
    </div>
  </section>

  <!-- Coaches Grid -->
  <section class="py-14 bg-surface-subtle">
    <div class="max-w-7xl mx-auto px-5 md:px-12">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {coachesList.map((coach) => (
          <div class="bg-white border border-slate-200 rounded-sm overflow-hidden shadow-xs hover:shadow-xl transition-all duration-200 flex flex-col justify-between group">
            <div>
              <div class="aspect-[4/5] bg-athletic-black overflow-hidden relative">
                <img
                  src={coach.image}
                  alt={coach.name}
                  class="w-full h-full object-contain bg-white group-hover:scale-103 transition-transform duration-300"
                />
              </div>
              <div class="p-5 space-y-2 border-t border-slate-100">
                <div class="inline-block bg-powder-50 text-brand-blue-dark border border-brand-blue/30 px-2 py-0.5 rounded-sm text-[10px] font-extrabold uppercase tracking-wider">
                  {coach.team}
                </div>
                <h2 class="font-display text-2xl font-black uppercase text-athletic-black leading-none">
                  {coach.name}
                </h2>
                <div class="text-xs font-bold uppercase tracking-wider text-brand-blue-dark">
                  {coach.role}
                </div>
                <p class="text-xs text-slate-600 leading-relaxed pt-1">
                  {coach.bio}
                </p>
              </div>
            </div>
            <div class="px-5 py-3 bg-surface-subtle border-t border-slate-100 flex items-center justify-between text-xs font-bold">
              <a href="/teams" class="text-athletic-black hover:text-brand-blue-dark uppercase tracking-wider">
                View Team →
              </a>
              <span class="text-slate-400">USAV / SafeSport</span>
            </div>
          </div>
        ))}
      </div>

      <!-- Interested in Coaching CTA -->
      <div class="mt-14 bg-athletic-black text-white p-8 rounded-sm border-l-4 border-brand-blue flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="space-y-1">
          <div class="text-xs font-extrabold uppercase tracking-widest text-brand-blue">JOIN OUR STAFF</div>
          <h3 class="font-display text-3xl font-black uppercase">PASSIONATE ABOUT COACHING YOUTH VOLLEYBALL?</h3>
          <p class="text-sm text-slate-300 max-w-xl">
            We are always looking for experienced collegiate players, high school coaches, and positional specialists to join the Summit family.
          </p>
        </div>
        <div class="flex flex-wrap gap-3 shrink-0">
          <a
            href="/for-coaches"
            class="inline-flex items-center gap-2 bg-white/10 hover:bg-white hover:text-athletic-black text-white border border-white/25 px-5 py-2.5 rounded-sm font-display text-lg uppercase font-bold tracking-wider transition-colors"
          >
            <span>Coaches Portal</span>
          </a>
          <a
            href={`mailto:${clubInfo.email}?subject=Coaching%20Inquiry%20-%20Summit%20Volleyball%20Club`}
            class="inline-flex items-center gap-2 bg-brand-blue hover:bg-brand-blue-dark text-athletic-black px-6 py-2.5 rounded-sm font-display text-lg uppercase font-black tracking-wider transition-colors"
          >
            <span>Apply to Coach</span>
            <span class="material-symbols-outlined text-base">arrow_forward</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
