---
import BaseLayout from '../layouts/BaseLayout.astro';
import { clubInfo, wholeAthletePillars } from '../data/clubData';
---

<BaseLayout title="About Us & Club Leadership | Summit Volleyball Club">
  <!-- Page Header with Background Image & Photo Collage -->
  <section class="bg-athletic-black text-white py-14 md:py-20 border-b-4 border-brand-blue relative overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src="/images/teams/17-1-girls.jpg"
        alt="Summit Volleyball Club team celebrating together"
        class="w-full h-full object-cover object-center opacity-25"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-athletic-black via-athletic-black/90 to-athletic-black/65"></div>
    </div>
    <div class="max-w-7xl mx-auto px-5 md:px-12 relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-7">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-sm bg-brand-blue/20 text-brand-blue border border-brand-blue/40 text-xs font-extrabold uppercase tracking-wider mb-3">
          <span class="material-symbols-outlined text-sm">info</span>
          <span>ABOUT SUMMIT VOLLEYBALL CLUB</span>
        </div>
        <h1 class="font-display font-black uppercase text-4xl sm:text-6xl tracking-tight leading-none">
          DEVELOPING THE <span class="text-brand-blue">COMPLETE ATHLETE</span>
        </h1>
        <p class="text-slate-200 text-base sm:text-lg max-w-2xl mt-3">
          18 Girls Teams &amp; 2 Boys Teams across 11U–18U • Training exclusively at TM Fieldhouse in Lee's Summit, Missouri.
        </p>
      </div>
      <div class="lg:col-span-5 grid grid-cols-2 gap-3">
        <div class="rounded-sm overflow-hidden border-2 border-brand-blue/50 shadow-xl aspect-4/3 bg-black">
          <img src="/images/gallery/action-4.jpg" alt="SVC Coaches and Players at the Net" class="w-full h-full object-cover" />
        </div>
        <div class="rounded-sm overflow-hidden border-2 border-white/20 shadow-xl aspect-4/3 bg-black">
          <img src="/images/teams/15-1-meq-champs.jpg" alt="SVC Championship Culture" class="w-full h-full object-cover" />
        </div>
      </div>
    </div>
  </section>

  <!-- Main Story & Mission -->
  <section class="py-14 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-5 md:px-12 grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <div class="lg:col-span-7 space-y-6 text-slate-700 leading-relaxed text-base">
        <div>
          <span class="font-display text-xl uppercase tracking-wider font-extrabold text-brand-blue-dark">
            OUR MISSION &amp; CULTURE
          </span>
          <h2 class="font-display font-black uppercase text-3xl sm:text-5xl text-athletic-black leading-none mt-1">
            MORE THAN A CLUB — A FAMILY &amp; PERFORMANCE ACADEMY
          </h2>
        </div>
        <p>
          <strong>Summit Volleyball Club (SVC)</strong> is a rapidly growing USA Volleyball (USAV) and JVA registered organization that focuses on the development of the <strong>whole player</strong>—from court skill development and competitive mindset to injury prevention and proper sports nutrition.
        </p>
        <p>
          With players from all over the Greater Kansas City metro area and beyond, SVC fields multiple <strong>Girls Premier, National, and Select level teams</strong> in age groups U10 through U18, alongside our nationally qualified <strong>Boys teams</strong> (19 Girls teams and 2 Boys teams). Players come to us with different abilities, and every member of our coaching staff shares one goal: helping each athlete develop, compete, and grow.
        </p>
        <p>
          Most of our teams practice twice a week for 2 hours each practice, while many of our National and Premier squads practice 3 nights a week. All volleyball practices are held exclusively in our home facility, <strong>TM Fieldhouse</strong>, located at <strong>1550 SE Hamblen Rd, Lee's Summit, MO</strong>.
        </p>

        <!-- Club Directors Leadership Callout -->
        <div class="p-6 rounded-sm bg-surface-subtle border-l-4 border-brand-blue space-y-4">
          <div>
            <div class="font-display font-black uppercase text-2xl text-athletic-black">
              Club Leadership &amp; Parent Connection
            </div>
            <div class="text-xs font-extrabold uppercase tracking-wider text-brand-blue-dark">
              Erin Wilson (Club Director) &amp; Hannah Berry (Assistant Club Director)
            </div>
          </div>
          <p class="text-sm text-slate-600 leading-relaxed">
            Club Director <strong>Erin Wilson</strong> and Assistant Club Director <strong>Hannah Berry</strong> take great pride in knowing the players and parents within the club. They are visible and make themselves available at practices on a routine basis to supply support to the coaches, work directly with players, and check in with parents. After all, club volleyball is as much a parent experience as it is a player experience!
          </p>
        </div>
      </div>

      <!-- Right Column: Facility Card -->
      <div class="lg:col-span-5 space-y-6">
        <div class="rounded-sm bg-athletic-black text-white p-7 space-y-4 shadow-xl border-t-4 border-brand-blue">
          <span class="inline-block px-2.5 py-1 rounded-sm bg-brand-blue text-athletic-black font-display font-black uppercase text-xs tracking-wider">
            Exclusive Home Facility
          </span>
          <h3 class="font-display font-black uppercase text-3xl">
            TM FIELDHOUSE • LEE'S SUMMIT, MO
          </h3>
          <p class="text-slate-300 text-sm leading-relaxed">
            All SVC practices, Open Gyms, and Positional Skills Clinics take place under one roof at TM Fieldhouse:
          </p>
          <div class="text-sm space-y-2 text-slate-200 font-medium pt-1">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-brand-blue text-base">location_on</span>
              <span>{clubInfo.facility.fullAddress}</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-brand-blue text-base">call</span>
              <span>{clubInfo.phone}</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-brand-blue text-base">mail</span>
              <span>{clubInfo.email}</span>
            </div>
          </div>
          <div class="pt-2">
            <a
              href={clubInfo.facility.mapUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 w-full bg-brand-blue hover:bg-brand-blue-dark text-athletic-black font-display text-lg font-black uppercase tracking-wider py-2.5 rounded-sm transition-colors"
            >
              <span>Get Directions on Google Maps</span>
              <span class="material-symbols-outlined text-base">arrow_forward</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Club Directors Showcase: Erin Wilson & Hannah Berry -->
  <section class="py-14 bg-surface-subtle border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-5 md:px-12">
      <div class="text-center max-w-3xl mx-auto mb-10 space-y-1">
        <span class="font-display text-xl uppercase tracking-wider font-extrabold text-brand-blue-dark">
          EXECUTIVE LEADERSHIP
        </span>
        <h2 class="font-display text-4xl sm:text-5xl font-black uppercase text-athletic-black">
          MEET OUR CLUB DIRECTORS
        </h2>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Erin Wilson: Club Director -->
        <div class="bg-white border border-slate-200 border-t-4 border-t-brand-blue rounded-sm overflow-hidden shadow-md grid grid-cols-1 sm:grid-cols-12">
          <div class="sm:col-span-5 bg-white flex items-center justify-center p-3 border-b sm:border-b-0 sm:border-r border-slate-100">
            <img
              src="/images/coaches/erin.png"
              alt="Erin Wilson - SVC Club Director"
              class="w-full h-auto object-contain rounded-sm"
            />
          </div>
          <div class="sm:col-span-7 p-6 flex flex-col justify-between space-y-4">
            <div class="space-y-2">
              <span class="inline-block bg-athletic-black text-brand-blue px-2.5 py-0.5 rounded-sm font-display text-xs font-black uppercase tracking-wider">
                CLUB DIRECTOR • 17 BLUE HEAD COACH
              </span>
              <h3 class="font-display text-3xl font-black uppercase text-athletic-black leading-none">
                ERIN WILSON
              </h3>
              <p class="text-xs text-slate-600 leading-relaxed">
                Erin brings more than 25 years of coaching experience and a passion for developing the complete athlete both on and off the court. A former collegiate hitter, she has helped athletes compete at the highest level—including qualifying her 18s team for the USAV National Championships.
              </p>
              <p class="text-xs text-slate-600 leading-relaxed">
                Her philosophy centers around building the full athlete by teaching players to respect their game, coaches, families, teammates, and themselves.
              </p>
            </div>
            <div class="pt-3 border-t border-slate-100 text-xs font-bold text-brand-blue-dark">
              Direct Contact: {clubInfo.phone} • {clubInfo.email}
            </div>
          </div>
        </div>

        <!-- Hannah Berry: Assistant Club Director -->
        <div class="bg-white border border-slate-200 border-t-4 border-t-athletic-black rounded-sm overflow-hidden shadow-md grid grid-cols-1 sm:grid-cols-12">
          <div class="sm:col-span-5 bg-white flex items-center justify-center p-3 border-b sm:border-b-0 sm:border-r border-slate-100">
            <img
              src="/images/coaches/hannah.png"
              alt="Hannah Berry - SVC Assistant Club Director"
              class="w-full h-auto object-contain rounded-sm"
            />
          </div>
          <div class="sm:col-span-7 p-6 flex flex-col justify-between space-y-4">
            <div class="space-y-2">
              <span class="inline-block bg-brand-blue text-athletic-black px-2.5 py-0.5 rounded-sm font-display text-xs font-black uppercase tracking-wider">
                ASSISTANT CLUB DIRECTOR • 14 NATIONAL HEAD COACH
              </span>
              <h3 class="font-display text-3xl font-black uppercase text-athletic-black leading-none">
                HANNAH BERRY
              </h3>
              <p class="text-xs text-slate-600 leading-relaxed">
                Serving as Assistant Club Director and 14 National Head Coach for the 2026–2027 season, Hannah Berry brings a lifelong passion for the game and a strong commitment to athlete development. Having played volleyball since the age of 9, Hannah was a member of the first SVC team to qualify for USAV Nationals, competing as a National-level libero.
              </p>
              <p class="text-xs text-slate-600 leading-relaxed">
                Entering her fifth year of coaching, Hannah places a strong emphasis on developing individual player skills, confidence, character, and a cohesive, hard-working club culture.
              </p>
            </div>
            <div class="pt-3 border-t border-slate-100 text-xs font-bold text-brand-blue-dark">
              SVC Alumna • USAV Nationals Qualifier • 5th Year SVC Coach
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 Whole-Athlete Performance Partners -->
  <section class="py-14 bg-white">
    <div class="max-w-7xl mx-auto px-5 md:px-12">
      <div class="max-w-3xl mb-10">
        <span class="font-display text-xl uppercase tracking-wider font-extrabold text-brand-blue-dark">
          ELITE SUPPORT TEAM
        </span>
        <h2 class="font-display font-black uppercase text-4xl sm:text-5xl text-athletic-black tracking-tight leading-none mt-1">
          OUR 4 PILLARS OF <span class="text-brand-blue-dark">WHOLE-PLAYER CARE</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {wholeAthletePillars.map((pillar) => (
          <div class="bg-surface-subtle rounded-sm p-7 border border-slate-200 shadow-xs space-y-2.5">
            <span class="inline-block px-2.5 py-0.5 rounded-sm bg-athletic-black text-brand-blue font-display font-black uppercase text-xs tracking-wider">
              {pillar.role}
            </span>
            <h3 class="font-display font-black uppercase text-3xl text-athletic-black">
              {pillar.expert}
            </h3>
            <div class="text-xs font-bold uppercase tracking-wider text-brand-blue-dark">
              {pillar.affiliation}
            </div>
            <p class="text-sm text-slate-600 leading-relaxed">
              {pillar.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
