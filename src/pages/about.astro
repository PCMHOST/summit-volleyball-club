---
import BaseLayout from '../layouts/BaseLayout.astro';
import { clubInfo, wholeAthletePillars } from '../data/clubData';
---

<BaseLayout title="About Us & Whole-Athlete Development | Summit Volleyball Club">
  <!-- Page Header -->
  <section class="bg-svc-navy text-white py-16 sm:py-20 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <span class="inline-block px-3 py-1 rounded bg-svc-royal text-white font-display font-bold uppercase tracking-widest text-xs mb-3">
        About Summit Volleyball Club
      </span>
      <h1 class="font-display font-black uppercase text-5xl sm:text-6xl tracking-tight leading-none">
        DEVELOPING THE <span class="text-svc-sky">COMPLETE ATHLETE</span>
      </h1>
      <p class="text-slate-200 text-lg max-w-2xl mt-3">
        19 Girls Teams & 2 Boys Teams across U10–U18 • Training exclusively at TM Fieldhouse in Lee's Summit, Missouri.
      </p>
    </div>
  </section>

  <!-- Main Story & Mission -->
  <section class="py-16 sm:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <div class="lg:col-span-7 space-y-6 text-slate-700 leading-relaxed text-base sm:text-lg">
        <h2 class="font-display font-black uppercase text-3xl sm:text-4xl text-svc-navy leading-none">
          MORE THAN A CLUB—A FAMILY & PERFORMANCE ACADEMY
        </h2>
        <p>
          <strong>Summit Volleyball Club (SVC)</strong> is a rapidly growing USA Volleyball (USAV) and JVA registered organization that focuses on the development of the <strong>whole player</strong>—from court skill development and competitive mindset to injury prevention and proper sports nutrition.
        </p>
        <p>
          With players from all over the Greater Kansas City metro area and beyond, SVC fields multiple <strong>Girls Premier, National, and Select level teams</strong> in age groups U10 through U18, alongside our nationally qualified <strong>Boys teams</strong> (19 Girls teams and 2 Boys teams). Players come to us with different abilities, and every member of our coaching staff shares one goal: helping each athlete develop, compete, and grow.
        </p>
        <p>
          Most of our teams practice twice a week for 2 hours each practice, while many of our National and Premier squads practice 3 nights a week. All volleyball practices are held exclusively in our home facility, <strong>TM Fieldhouse</strong>, located at <strong>1550 SE Hamblen Rd, Lee's Summit, MO</strong>.
        </p>

        <!-- Club Director Callout -->
        <div class="p-6 rounded-xl bg-svc-ice border-l-4 border-svc-royal space-y-2">
          <div class="font-display font-extrabold uppercase text-xl text-svc-navy">
            Leadership & Parent Connection — Erin Wilson, Club Director
          </div>
          <p class="text-sm sm:text-base text-slate-600">
            Club Director <strong>Erin Wilson</strong> takes great pride in knowing the players and parents within the club. She is visible and makes herself available at practices on a routine basis to supply support to the coaches, work directly with players, and check in with parents. After all, club volleyball is as much a parent experience as it is a player experience!
          </p>
        </div>
      </div>

      <!-- Right Column: Facility Card & Director Graphic -->
      <div class="lg:col-span-5 space-y-6">
        <div class="rounded-xl overflow-hidden border border-slate-200 shadow-md bg-white">
          <img src="/images/coaches/erin.png" alt="Erin Wilson - SVC Club Director" class="w-full h-auto object-cover" />
        </div>

        <div class="rounded-xl bg-svc-navy text-white p-6 space-y-4 shadow-lg">
          <span class="px-2.5 py-1 rounded bg-svc-gold text-svc-navy font-display font-extrabold uppercase text-xs tracking-wider">
            Exclusive Home Facility
          </span>
          <h3 class="font-display font-extrabold uppercase text-2xl">
            TM FIELDHOUSE • LEE'S SUMMIT, MO
          </h3>
          <p class="text-slate-300 text-sm">
            All SVC practices, Open Gyms, and Advanced Skills Clinics take place at TM Fieldhouse:
          </p>
          <div class="text-sm space-y-1 text-slate-200 font-medium">
            <div>📍 {clubInfo.facility.fullAddress}</div>
            <div>📞 {clubInfo.phone}</div>
            <div>✉️ {clubInfo.email}</div>
          </div>
          <a
            href={clubInfo.facility.mapUrl}
            target="_blank"
            rel="noopener"
            class="inline-block w-full text-center bg-svc-royal hover:bg-blue-500 text-white font-display font-bold uppercase tracking-wider py-2.5 rounded transition-colors"
          >
            Get Directions on Google Maps
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 Whole-Athlete Performance Partners -->
  <section class="py-16 sm:py-20 bg-svc-ice border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-12">
        <span class="font-display font-extrabold uppercase tracking-[0.2em] text-svc-royal text-sm">
          Elite Support Team
        </span>
        <h2 class="font-display font-black uppercase text-4xl sm:text-5xl text-svc-navy tracking-tight leading-none mt-1">
          OUR 4 PILLARS OF <span class="text-svc-royal">WHOLE-PLAYER CARE</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {wholeAthletePillars.map((pillar) => (
          <div class="bg-white rounded-xl p-8 border border-slate-200 shadow-xs space-y-3">
            <span class="inline-block px-3 py-1 rounded bg-svc-sky-light text-svc-blue font-display font-bold uppercase text-xs tracking-wider">
              {pillar.role}
            </span>
            <h3 class="font-display font-extrabold uppercase text-3xl text-svc-navy">
              {pillar.expert}
            </h3>
            <div class="text-sm font-bold text-svc-royal">
              {pillar.affiliation}
            </div>
            <p class="text-slate-600 leading-relaxed">
              {pillar.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
